{
    "name": "twannes-claes-portfolio",
    "private": true,
    "type": "module",
    "description": "Portfolio of Twannes Claes",
    "scripts": {
        "dev": "vite",
        "build": "vite-react-ssg build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "eslint . --fix && prettier --write .",
        "images": "node scripts/optimize-images.ts"
    },
    "prettier": {
        "singleQuote": true,
        "semi": true,
        "tabWidth": 4,
        "printWidth": 100,
        "trailingComma": "all",
        "embeddedLanguageFormatting": "off"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "6.7.2",
        "@fortawesome/free-brands-svg-icons": "6.7.2",
        "@fortawesome/free-regular-svg-icons": "6.7.2",
        "@fortawesome/free-solid-svg-icons": "6.7.2",
        "@fortawesome/react-fontawesome": "^3.5.0",
        "firebase": "^12.19.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^6.30.6",
        "vite-react-ssg": "^0.9.2",
        "yet-another-react-lightbox": "^3.32.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/nunito": "^5.3.0",
        "@fontsource-variable/onest": "^5.3.1",
        "@fontsource/lilita-one": "^5.3.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "jiti": "^2.7.0",
        "prettier": "^3.9.6",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0"
    }
