rules_version = '2';

// Paste into the Firebase console, Firestore Database, Rules. The email must match
// accountEmail in services/config.ts, so a stray sign-up on the same project still cannot
// touch the collection.
service cloud.firestore {
  match /databases/{database}/documents {
    match /skylanders/{id} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'skylanders@twannes.github.io';
    }
  }
}
